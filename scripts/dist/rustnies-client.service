[Unit]
Description=rustnies VPN client daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__PREFIX__/bin/rustnies client
Restart=on-failure
RestartSec=2
# The daemon wires SIGINT (Ctrl+C) to its graceful-shutdown path, which sends
# a Close to the peer before exiting, so have systemd send SIGINT too.
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=15
LimitNOFILE=4096

RuntimeDirectory=rustnies
RuntimeDirectoryMode=0755
StateDirectory=rustnies
StateDirectoryMode=0700
ConfigurationDirectory=rustnies

# The client creates TUN devices, installs routes (netlink), runs iptables
# for the kill switch / DNS leak prevention, and rewrites /etc/resolv.conf.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
