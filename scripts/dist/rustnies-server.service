[Unit]
Description=rustnies VPN server daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__PREFIX__/bin/rustnies server
Restart=on-failure
RestartSec=2
# The daemon wires SIGINT (Ctrl+C) to its graceful-shutdown path, which sends
# a Close to the peer before exiting, so have systemd send SIGINT too.
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=15
LimitNOFILE=4096

# systemd creates and owns these directories so the daemon doesn't need to.
RuntimeDirectory=rustnies
RuntimeDirectoryMode=0755
StateDirectory=rustnies
StateDirectoryMode=0700
ConfigurationDirectory=rustnies

# The server creates TUN devices and installs routes/NAT/iptables rules, so
# it needs raw network administration.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
